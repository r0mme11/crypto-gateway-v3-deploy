# Shared by api, admin-api and the migrate job. Internal service hostnames.
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USERNAME=wallet
DATABASE_PASSWORD=wallet
DATABASE_NAME=wallet
DATABASE_URL=postgresql://wallet:wallet@db:5432/wallet?schema=public

REDIS_CONNECT_STRING=redis://redis:6379

# Envelope-encryption master key for @app/keyvault (32 bytes base64).
# SECRET — set a unique value per environment.
MASTER_KEK=oI+Vv27b3MXZVdyfOhBhoqUKC6XgxJZkkTg3ITJMpwk=

# Deposit pipeline (workers)
# Comma-separated Tron RPC endpoints (Chainstack primary, then fallbacks).
TRON_RPC_URLS=https://tron-mainnet.core.chainstack.com/d59a86948d85f2e04e84bd0fc8fc04a4,https://api.trongrid.io
# Energy provider for TRC20 sweeps: noop (default; energy supplied out-of-band).
# Plug in a real rental provider (tronzap/itrx) here when credentials exist.
ENERGY_PROVIDER=tronzap
# TronZap energy rental — set ENERGY_PROVIDER=tronzap and fill these to enable.
TRONZAP_API_TOKEN=n8b2eog4XMJGUZV3db6M3iwxRvErmFQ2
